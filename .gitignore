# Secrets : config.toml contient le cookie de session (JWT) — NE PAS versionner.
# Seul config.example.toml (sans secret) doit l'être.
config.toml
# Multi-comptes : accounts.toml contient les cookies de plusieurs comptes — NE PAS versionner.
# Seul accounts.example.toml (sans secret) doit l'être.
accounts.toml

